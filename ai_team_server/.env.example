# Runtime
PORT=3000
NODE_ENV=development

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Authentication
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Optional test-token authentication. If omitted, this test platform uses the
# built-in development token. Never use that fallback with production data.
DEV_API_TOKEN=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pearl Admin integration
ADMIN_API_KEY=
PEARL_ADMIN_API_URL=

# Optional comma-separated frontend origins. Leave empty to allow all origins
# for a test deployment, or set deployed frontend URLs for stricter CORS.
CORS_ORIGINS=
